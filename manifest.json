{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "1.3.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/sugeflow/papercard",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "clipboardWrite",
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://www.reddit.com/*",
    "https://reddit.com/*",
    "https://*.redd.it/*",
    "https://*.redditmedia.com/*",
    "https://*.redditstatic.com/*",
    "https://cdn.bsky.app/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://*.sinaimg.cn/*",
    "https://*.zhimg.com/*",
    "https://*.xhscdn.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.reddit.com/*",
        "https://reddit.com/*",
        "https://new.reddit.com/*",
        "https://sh.reddit.com/*",
        "https://bsky.app/*",
        "https://www.threads.com/*",
        "https://www.threads.net/*",
        "https://www.instagram.com/*",
        "https://weibo.com/*",
        "https://www.weibo.com/*",
        "https://www.zhihu.com/*",
        "https://zhuanlan.zhihu.com/*",
        "https://www.xiaohongshu.com/*"
      ],
      "js": [
        "src/core.js",
        "src/qrcode.js",
        "src/renderer.js",
        "src/platforms.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "create-selection-card": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_commandCreateCard__"
    }
  },
  "options_page": "src/options.html"
}
